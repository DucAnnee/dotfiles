# Shell assignments, sourced by Bash. Environment overrides take precedence.
# ${NAME:-default} uses default when NAME is unset or empty.
# Assignments have no spaces around =. For example, INSTALL_PNPM=1 bash setup.sh
# passes a variable to that command and the child processes it starts.
PYTHON_VERSION=${PYTHON_VERSION:-3.12}
NODE_VERSION=${NODE_VERSION:-lts}
JAVA_VERSION=${JAVA_VERSION:-temurin-25}
TYPESCRIPT_VERSION=${TYPESCRIPT_VERSION:-latest}
PNPM_VERSION=${PNPM_VERSION:-latest}
NEOVIM_VERSION=${NEOVIM_VERSION:-stable}
SESH_VERSION=${SESH_VERSION:-2.32.0}
NERD_FONTS_VERSION=${NERD_FONTS_VERSION:-3.5.1}
# These switches use 0 for disabled and 1 for enabled; common.sh validates them.
INSTALL_PNPM=${INSTALL_PNPM:-0}
INSTALL_MAVEN=${INSTALL_MAVEN:-0}
INSTALL_DOCKER=${INSTALL_DOCKER:-0}
INSTALL_SNAP=${INSTALL_SNAP:-0}
